{
  "name": "ai-pr-summarizer",
  "version": "1.0.0",
  "description": "GitHub Action that summarizes PR diffs using OpenAI and posts structured comments.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --license licenses.txt",
    "build:watch": "ncc build src/index.ts -o dist --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "github-action",
    "openai",
    "pull-request",
    "summary",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "openai": "^4.52.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vercel/ncc": "^0.38.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
